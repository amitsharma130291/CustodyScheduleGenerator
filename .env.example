# ── CustodyBuilder environment variables ──────────────────────────────────────
#
# This file documents required Cloudflare Pages environment bindings.
# Never commit real values. Set these in:
#   Cloudflare Dashboard → Pages → custodyschedulegenerator → Settings
#   → Environment variables → Production (and optionally Preview)
#

# ── Contact form (Resend) ──────────────────────────────────────────────────────
# Required for /contact/ form submissions to reach amitsharma00261@gmail.com.
# 1. Create a free account at https://resend.com
# 2. Add and verify the sending domain (custodybuilder.com) under Domains
# 3. Create an API key under API Keys with "Sending access" permission
# 4. Add this binding in Cloudflare Pages dashboard (see above)
RESEND_API_KEY=re_...
