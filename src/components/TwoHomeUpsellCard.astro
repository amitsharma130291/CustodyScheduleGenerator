---
// Compact, static promo card for the $7 Two-Home Transition Checklist — a
// standalone product in its own right, that also pairs with My Custody
// Calendar. Mirrors CalendarUpsellCard.astro's shape (no client-side
// state, safe on any page) but in the product's own teal identity
// (matching two-home-offer.astro) so the two read as related-but-distinct
// products, not one card with two prices.
//
// Checkout never required a calendar purchase server-side (calendarPaymentId
// is optional metadata) — the old "add-on only" framing was a front-end
// decision on two-home-checklist.astro, since reversed. This CTA links
// straight to that page, which now shows the questionnaire to everyone.
interface Props {
	/** Tailoring the lead-in line to the page it's dropped on reads less like a repeated ad unit. Keep to one sentence. */
	lead?: string;
}
const { lead = "Whether or not you've built a calendar here, this solves the suitcase." } = Astro.props;
---

<aside class="two-home-upsell-card" aria-label="Two-Home Transition Checklist — $7 standalone or bundled">
	<div class="two-home-upsell-card__text">
		<p class="text-[11px] font-bold uppercase tracking-[0.16em]" style="color: var(--cal-parent-b)">$7 once · works alone or with your calendar</p>
		<p class="mt-1.5 text-base font-semibold leading-6 text-primary">{lead} Get the Two-Home Transition Checklist.</p>
		<p class="mt-1 text-sm leading-6 text-secondary">What stays at each home, what travels between them, and a switch-day list — so nothing gets left behind, and nobody has to text "did you pack the retainer?" again.</p>
	</div>
	<a href="/two-home-checklist/" class="btn-primary btn-primary--wrap flex min-h-12 w-full shrink-0 items-center justify-center gap-2 rounded-full px-6 text-center text-sm font-semibold sm:w-auto sm:whitespace-nowrap">
		Get the $7 Two-Home Checklist
	</a>
</aside>

<style>
	.two-home-upsell-card {
		display: flex;
		flex-direction: column;
		gap: 16px;
		align-items: flex-start;
		border-radius: 1.25rem;
		border: 1px solid var(--border-subtle);
		background: var(--cal-parent-b-soft);
		padding: 20px;
		margin-block: 32px;
	}
	@media (min-width: 640px) {
		.two-home-upsell-card {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			padding: 24px 28px;
		}
	}
</style>
