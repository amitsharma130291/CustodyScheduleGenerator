---
import {
	calculateCAChildSupport,
} from '../../lib/calculators/californiaChildSupport';

const initialInput = {
	netDisposableIncomeA: 4000,
	netDisposableIncomeB: 8000,
	numberOfChildren: 1,
	timeshareA: (365 - 100) / 365,
	timeshareB: 100 / 365,
	qualifyingChildcare: 0,
	qualifyingHealthcare: 0,
	spousalSupportAPaysB: 0,
	spousalSupportBPaysA: 0,
} as const;

const initialResult = calculateCAChildSupport(initialInput);

function fmt(n: number) {
	return '$' + n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
}
---

<section id="ca-calculator" class="premium-card rounded-[1.6rem] p-3 sm:p-4" data-california-child-support-calculator>
	<div class="rounded-[1.25rem] bg-surface-elevated p-3 shadow-[inset_0_1px_0_rgba(255,255,255,0.07)] sm:p-4">
		<div class="grid gap-4 xl:grid-cols-[0.92fr_1.08fr] xl:items-start">

			<!-- Inputs -->
			<div>
				<p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">California §4055 Guideline Calculator</p>
				<h2 class="mt-1.5 text-xl font-semibold tracking-[-0.04em] text-primary sm:text-2xl">Enter income &amp; timeshare</h2>
				<p class="mt-1.5 text-xs leading-4 text-muted">
					Use net monthly disposable income after taxes and mandatory deductions. Version CA-CS-2026.1.
				</p>

				<form class="mt-2.5 grid gap-2.5" data-ca-child-support-form>

					<label class="grid gap-0.5">
						<span class="text-sm font-medium text-secondary">Parent A net monthly disposable income ($)</span>
						<input name="netIncomeA" type="number" min="0" step="0.01" value={initialInput.netDisposableIncomeA} inputmode="decimal"
							class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
						<span class="text-[11px] leading-4 text-muted">After federal/state income tax, FICA, and mandatory deductions.</span>
					</label>

					<label class="grid gap-0.5">
						<span class="text-sm font-medium text-secondary">Parent B net monthly disposable income ($)</span>
						<input name="netIncomeB" type="number" min="0" step="0.01" value={initialInput.netDisposableIncomeB} inputmode="decimal"
							class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
						<span class="text-[11px] leading-4 text-muted">The higher earner typically pays the lower earner.</span>
					</label>

					<label class="grid gap-0.5">
						<span class="text-sm font-medium text-secondary">Number of children</span>
						<select name="numberOfChildren" class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]">
							<option value="1" selected>1 child</option>
							<option value="2">2 children</option>
							<option value="3">3 children</option>
							<option value="4">4 children</option>
							<option value="5">5 children</option>
							<option value="6">6 children</option>
							<option value="7">7 children</option>
							<option value="8">8 children</option>
							<option value="9">9 children</option>
							<option value="10">10 children</option>
						</select>
					</label>

					<div class="grid grid-cols-2 gap-2">
						<label class="grid gap-0.5">
							<span class="text-sm font-medium text-secondary">Parent A overnights/year</span>
							<input name="overnightsA" type="number" min="0" max="365" step="1" value="265" inputmode="numeric"
								class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
						</label>
						<label class="grid gap-0.5">
							<span class="text-sm font-medium text-secondary">Parent B overnights/year</span>
							<input name="overnightsB" type="number" min="0" max="365" step="1" value="100" inputmode="numeric"
								class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
						</label>
					</div>
					<span class="text-[11px] leading-4 text-muted" data-ca-overnight-hint>
						Timeshare (H) is the high earner's fraction of total overnights.
					</span>

					<details class="group rounded-[1.1rem] bg-page/45 p-2.5 shadow-[inset_0_0_0_1px_var(--border-subtle)]">
						<summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold text-primary">
							Add-ons &amp; spousal support (§4062)
							<span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-surface text-lg leading-none text-muted shadow-[inset_0_0_0_1px_var(--border-subtle)] transition-transform group-open:rotate-45">+</span>
						</summary>
						<div class="mt-3 grid gap-3">
							<label class="grid gap-1">
								<span class="text-sm font-medium text-secondary">Monthly work/education childcare ($)</span>
								<input name="qualifyingChildcare" type="number" min="0" step="0.01" value="0" inputmode="decimal"
									class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
								<span class="text-[11px] leading-4 text-muted">Apportioned by adjusted income (§4062(a)(1)). Separate from §4055 base.</span>
							</label>
							<label class="grid gap-1">
								<span class="text-sm font-medium text-secondary">Monthly uninsured healthcare costs ($)</span>
								<input name="qualifyingHealthcare" type="number" min="0" step="0.01" value="0" inputmode="decimal"
									class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
								<span class="text-[11px] leading-4 text-muted">Uninsured medical/dental/vision (§4062(a)(2)). Separate from §4055 base.</span>
							</label>
							<label class="grid gap-1">
								<span class="text-sm font-medium text-secondary">Spousal support A pays B ($/mo)</span>
								<input name="spousalSupportAPaysB" type="number" min="0" step="0.01" value="0" inputmode="decimal"
									class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
							</label>
							<label class="grid gap-1">
								<span class="text-sm font-medium text-secondary">Spousal support B pays A ($/mo)</span>
								<input name="spousalSupportBPaysA" type="number" min="0" step="0.01" value="0" inputmode="decimal"
									class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
							</label>
						</div>
					</details>

					<div class="hidden rounded-xl bg-red-50 px-3 py-2 text-xs text-red-700" data-ca-error></div>
				</form>
			</div>

			<!-- Results -->
			<div class="rounded-[1.35rem] bg-page/65 p-4 shadow-[inset_0_0_0_1px_var(--border-subtle)]" aria-live="polite">
				<p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">Estimated Monthly Support</p>
				<p class="mt-2 text-4xl font-bold leading-none tracking-[-0.06em] text-accent sm:text-5xl" data-ca-support-monthly>
					{fmt(initialResult.finalSupport)}
				</p>
				<p class="mt-2 text-xs leading-5 text-muted" data-ca-direction>
					{initialResult.payer ? `Parent ${initialResult.payer} pays Parent ${initialResult.recipient}` : 'No transfer'} — planning estimate only.
				</p>

				<div class="mt-3 rounded-xl bg-surface-elevated/70 px-3 py-2 text-xs leading-5 text-secondary shadow-[inset_0_0_0_1px_var(--border-subtle)]">
					<p class="font-semibold text-primary" data-ca-high-earner-status>
						High earner: Parent {initialResult.highEarner} | H = {(initialResult.H * 100).toFixed(1)}% | K = {initialResult.K.toFixed(4)}
					</p>
				</div>

				<!-- Calculation receipt (collapsible) -->
				<details class="mt-4 group">
					<summary class="flex cursor-pointer items-center justify-between gap-2 rounded-xl bg-surface-elevated/60 px-3 py-2 text-xs font-semibold text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]">
						Show calculation receipt
						<span class="text-muted transition-transform group-open:rotate-180">▾</span>
					</summary>
					<div class="mt-2 rounded-xl bg-surface-elevated/60 p-3 shadow-[inset_0_0_0_1px_var(--border-subtle)]">
						<ol class="grid gap-1.5 text-[11px] leading-5 text-secondary" data-ca-receipt>
							{initialResult.receipt.map(line => {
								const colonIdx = line.indexOf(':');
								const label = colonIdx >= 0 ? line.slice(0, colonIdx) : line;
								const value = colonIdx >= 0 ? line.slice(colonIdx + 1).trim() : '';
								return (
									<li class="flex items-start justify-between gap-3 border-b border-line-subtle pb-1 last:border-0 last:pb-0">
										<span>{label}</span>
										<strong class="shrink-0 text-right text-primary">{value}</strong>
									</li>
								);
							})}
						</ol>
					</div>
				</details>

				<div class="hidden mt-3 rounded-xl bg-amber-50 px-3 py-2 text-[11px] leading-5 text-amber-800" data-ca-low-income-warning></div>
				<div class="hidden mt-3 rounded-xl bg-amber-50 px-3 py-2 text-[11px] leading-5 text-amber-800" data-ca-children-warning></div>

				<p class="mt-3 rounded-xl bg-surface/70 p-3 text-[11px] leading-4 text-muted shadow-[inset_0_0_0_1px_var(--border-subtle)]">
					Estimate based on California Family Code §4055 guideline formula (CA-CS-2026.1). Add-ons are calculated separately under §4062. Your actual order may differ. Consult a licensed California family law attorney.
				</p>

				<div class="mt-3">
					<a href="/overnight-custody-calculator/" class="inline-flex rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:opacity-90" style="color: #ffffff">
						Calculate your parenting time &rarr;
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import { trackGa4Event } from '../../lib/analytics/ga4';
	import { calculateCAChildSupport } from '../../lib/calculators/californiaChildSupport';

	document.querySelectorAll('[data-california-child-support-calculator]').forEach((calculator) => {
		const form = calculator.querySelector('[data-ca-child-support-form]');
		const errorEl = calculator.querySelector('[data-ca-error]');
		const monthlyEl = calculator.querySelector('[data-ca-support-monthly]');
		const directionEl = calculator.querySelector('[data-ca-direction]');
		const highEarnerStatusEl = calculator.querySelector('[data-ca-high-earner-status]');
		const receiptEl = calculator.querySelector('[data-ca-receipt]');
		const lowIncomeWarningEl = calculator.querySelector('[data-ca-low-income-warning]');
		const childrenWarningEl = calculator.querySelector('[data-ca-children-warning]');

		function fmt(n: number) {
			return '$' + n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
		}

		function renderReceipt(lines: string[]) {
			if (!receiptEl) return;
			receiptEl.innerHTML = lines.map(line => {
				const colonIdx = line.indexOf(':');
				const label = colonIdx >= 0 ? line.slice(0, colonIdx) : line;
				const value = colonIdx >= 0 ? line.slice(colonIdx + 1).trim() : '';
				return `<li class="flex items-start justify-between gap-3 border-b border-line-subtle pb-1 last:border-0 last:pb-0">
					<span>${label}</span>
					<strong class="shrink-0 text-right text-primary">${value}</strong>
				</li>`;
			}).join('');
		}

		function showError(message: string) {
			if (!errorEl) return;
			errorEl.textContent = message;
			errorEl.classList.remove('hidden');
		}

		function clearError() {
			if (!errorEl) return;
			errorEl.textContent = '';
			errorEl.classList.add('hidden');
		}

		function update() {
			if (!(form instanceof HTMLFormElement)) return;
			const data = new FormData(form);
			const g = (name: string) => Number(data.get(name)) || 0;

			try {
				const overnightsA = g('overnightsA');
				const overnightsB = g('overnightsB');
				const totalOvernights = overnightsA + overnightsB || 365;
				const timeshareA = overnightsA / totalOvernights;
				const timeshareB = overnightsB / totalOvernights;

				const result = calculateCAChildSupport({
					netDisposableIncomeA: g('netIncomeA'),
					netDisposableIncomeB: g('netIncomeB'),
					numberOfChildren: Math.max(1, Math.round(g('numberOfChildren'))),
					timeshareA,
					timeshareB,
					qualifyingChildcare: g('qualifyingChildcare'),
					qualifyingHealthcare: g('qualifyingHealthcare'),
					spousalSupportAPaysB: g('spousalSupportAPaysB'),
					spousalSupportBPaysA: g('spousalSupportBPaysA'),
				});

				clearError();

				if (monthlyEl) monthlyEl.textContent = fmt(result.finalSupport);
				if (directionEl) {
					directionEl.textContent = result.payer
						? `Parent ${result.payer} pays Parent ${result.recipient} — planning estimate only.`
						: 'No transfer — planning estimate only.';
				}
				if (highEarnerStatusEl) {
					highEarnerStatusEl.textContent =
						`High earner: Parent ${result.highEarner} | H = ${(result.H * 100).toFixed(1)}% | K = ${result.K.toFixed(4)}`;
				}

				renderReceipt(result.receipt);

				if (lowIncomeWarningEl) {
					if (result.lowIncomeAdjustmentEligible && result.lowIncomeAdjustedRange) {
						lowIncomeWarningEl.textContent =
							`Low-income adjustment may apply. Adjusted range: ${fmt(result.lowIncomeAdjustedRange[0])} – ${fmt(result.lowIncomeAdjustedRange[1])}/month.`;
						lowIncomeWarningEl.classList.remove('hidden');
					} else {
						lowIncomeWarningEl.classList.add('hidden');
					}
				}

				if (childrenWarningEl) {
					if (result.childrenWarning) {
						childrenWarningEl.textContent = result.childrenWarning;
						childrenWarningEl.classList.remove('hidden');
					} else {
						childrenWarningEl.classList.add('hidden');
					}
				}

				trackGa4Event('calculate_ca_child_support');
			} catch (err) {
				showError(err instanceof Error ? err.message : 'Enter valid values to calculate.');
			}
		}

		form?.addEventListener('input', update);
		form?.addEventListener('change', update);
		update();
	});
</script>
