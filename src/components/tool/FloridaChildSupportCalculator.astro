---
import {
	calculateFloridaChildSupport,
	formatFloridaCurrency,
	formatFloridaPercent,
} from '../../lib/calculators/floridaChildSupport';

const initialInput = {
	netIncomeA: 6500,
	netIncomeB: 3500,
	numberOfChildren: 1,
	parentBOvernights: 60,
	monthlyChildcare: 0,
	monthlyHealthInsurance: 0,
} as const;
const initialResult = calculateFloridaChildSupport(initialInput);
---

<section id="fl-calculator" class="premium-card rounded-[1.6rem] p-3 sm:p-4" data-florida-child-support-calculator>
	<div class="rounded-[1.25rem] bg-surface-elevated p-3 shadow-[inset_0_1px_0_rgba(255,255,255,0.07)] sm:p-4">
		<div class="grid gap-4 xl:grid-cols-[0.92fr_1.08fr] xl:items-start">

			<!-- Inputs -->
			<div>
				<p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">Florida Income Shares Calculator</p>
				<h2 class="mt-1.5 text-xl font-semibold tracking-[-0.04em] text-primary sm:text-2xl">Enter income &amp; parenting time</h2>
				<p class="mt-1.5 text-xs leading-4 text-muted">
					Use net monthly income after taxes, FICA, and health insurance premiums.
				</p>

				<form class="mt-2.5 grid gap-2.5" data-fl-child-support-form>

					<label class="grid gap-0.5">
						<span class="text-sm font-medium text-secondary">Parent A net monthly income ($)</span>
						<input name="netIncomeA" type="number" min="0" step="0.01" value={initialInput.netIncomeA} inputmode="decimal"
							class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
						<span class="text-[11px] leading-4 text-muted">After taxes, FICA, and child health insurance deductions.</span>
					</label>

					<label class="grid gap-0.5">
						<span class="text-sm font-medium text-secondary">Parent B net monthly income ($)</span>
						<input name="netIncomeB" type="number" min="0" step="0.01" value={initialInput.netIncomeB} inputmode="decimal"
							class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
						<span class="text-[11px] leading-4 text-muted">The paying parent (non-primary residential).</span>
					</label>

					<label class="grid gap-0.5">
						<span class="text-sm font-medium text-secondary">Number of children</span>
						<select name="numberOfChildren" class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]">
							<option value="1" selected>1 child</option>
							<option value="2">2 children</option>
							<option value="3">3 children</option>
							<option value="4">4 children</option>
							<option value="5">5 children</option>
							<option value="6">6 children</option>
						</select>
					</label>

					<label class="grid gap-0.5">
						<span class="text-sm font-medium text-secondary">Parent B overnights per year</span>
						<input name="parentBOvernights" type="number" min="0" max="365" step="1" value={initialInput.parentBOvernights} inputmode="numeric"
							class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
						<span class="text-[11px] leading-4 text-muted">73+ nights triggers a support reduction. 110+ triggers extended reduction.</span>
					</label>

					<details class="group rounded-[1.1rem] bg-page/45 p-2.5 shadow-[inset_0_0_0_1px_var(--border-subtle)]">
						<summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold text-primary">
							Add-ons (childcare &amp; health insurance)
							<span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-surface text-lg leading-none text-muted shadow-[inset_0_0_0_1px_var(--border-subtle)] transition-transform group-open:rotate-45">+</span>
						</summary>
						<div class="mt-3 grid gap-3">
							<label class="grid gap-1">
								<span class="text-sm font-medium text-secondary">Monthly childcare costs ($)</span>
								<input name="monthlyChildcare" type="number" min="0" step="0.01" value="0" inputmode="decimal"
									class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
								<span class="text-[11px] leading-4 text-muted">Work-related childcare split proportionally by income.</span>
							</label>
							<label class="grid gap-1">
								<span class="text-sm font-medium text-secondary">Monthly health insurance for children ($)</span>
								<input name="monthlyHealthInsurance" type="number" min="0" step="0.01" value="0" inputmode="decimal"
									class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
								<span class="text-[11px] leading-4 text-muted">Children's premium only — the difference between employee-only and dependent coverage.</span>
							</label>
						</div>
					</details>

					<p class="flex items-start gap-2 rounded-xl bg-[rgba(37,99,235,0.07)] px-2.5 py-2 text-xs leading-[1.25] text-[color-mix(in_srgb,var(--accent)_72%,var(--text-secondary))] shadow-[inset_0_0_0_1px_rgba(37,99,235,0.16)] sm:items-center">
						<span class="mt-px grid h-4 w-4 shrink-0 place-items-center rounded-full bg-[rgba(37,99,235,0.1)] text-[10px] font-semibold leading-none text-accent sm:mt-0" aria-hidden="true">i</span>
						<span>Florida uses net income after taxes. Enter the amount after federal/state tax and FICA deductions.</span>
					</p>

					<button type="submit" class="btn-primary inline-flex h-12 w-full items-center justify-center whitespace-nowrap rounded-full px-5 text-sm font-semibold transition-all duration-200 ease-out hover:-translate-y-px active:translate-y-0">
						Calculate Estimate
					</button>
					<p class="hidden rounded-xl bg-page/70 p-2.5 text-xs leading-5 text-secondary shadow-[inset_0_0_0_1px_var(--border-subtle)]" data-fl-error></p>
				</form>
			</div>

			<!-- Results -->
			<div class="rounded-[1.35rem] bg-page/65 p-4 shadow-[inset_0_0_0_1px_var(--border-subtle)]" aria-live="polite">
				<p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">Estimated Monthly Support</p>
				<p class="mt-2 text-4xl font-bold leading-none tracking-[-0.06em] text-accent sm:text-5xl" data-fl-support-monthly>
					{formatFloridaCurrency(initialResult.monthlySupport)}
				</p>
				<p class="mt-2 text-xs leading-5 text-muted">Parent B pays Parent A — planning estimate only.</p>

				<div class="mt-5 rounded-[1.15rem] bg-surface-elevated/75 p-4 text-sm leading-6 text-secondary shadow-[inset_0_0_0_1px_var(--border-subtle)]">
					<p class="font-semibold text-primary">Calculation breakdown</p>
					<div class="mt-3 grid gap-3">

						<div class="flex items-start justify-between gap-4">
							<span>Combined net income</span>
							<strong class="text-right text-[#0F766E]" data-fl-combined-income>{formatFloridaCurrency(initialResult.combinedIncome)}</strong>
						</div>

						<div class="flex items-start justify-between gap-4">
							<span>Basic obligation ({initialInput.numberOfChildren} child)</span>
							<strong class="text-right text-[#0F766E]" data-fl-basic-obligation>{formatFloridaCurrency(initialResult.basicObligation)}</strong>
						</div>

						<div class="flex items-start justify-between gap-4 border-t border-line-subtle pt-3">
							<span>Parent B income share</span>
							<strong class="rounded-full bg-page px-2.5 py-1 text-right text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" data-fl-parent-b-share>
								{formatFloridaPercent(initialResult.parentBSharePct)}
							</strong>
						</div>

						<div class="flex items-start justify-between gap-4">
							<span>Parent B base obligation</span>
							<strong class="text-right text-[#2563EB]" data-fl-base-obligation>{formatFloridaCurrency(initialResult.parentBBaseObligation)}</strong>
						</div>

						<div class="hidden flex items-start justify-between gap-4" data-fl-overnight-row>
							<span data-fl-overnight-label>Overnight credit</span>
							<strong class="text-right text-red-600" data-fl-overnight-credit>-{formatFloridaCurrency(initialResult.overnightCredit)}</strong>
						</div>

						<div class="hidden flex items-start justify-between gap-4" data-fl-childcare-row>
							<span>Childcare add-on (Parent B)</span>
							<strong class="text-right text-[#0F766E]" data-fl-childcare>+{formatFloridaCurrency(initialResult.parentBChildcare)}</strong>
						</div>

						<div class="hidden flex items-start justify-between gap-4" data-fl-insurance-row>
							<span>Health insurance add-on (Parent B)</span>
							<strong class="text-right text-[#0F766E]" data-fl-insurance>+{formatFloridaCurrency(initialResult.parentBHealthInsurance)}</strong>
						</div>

						<div class="hidden rounded-xl bg-[rgba(45,212,191,0.12)] p-2.5 text-xs leading-5 text-secondary shadow-[inset_0_0_0_1px_rgba(45,212,191,0.28)]" data-fl-minimum-notice>
							Florida minimum of $50/child/month applied (F.S. § 61.30(1)(b)).
						</div>

						<div class="flex items-start justify-between gap-4 rounded-xl bg-page/70 p-3 border-t border-line-subtle pt-3">
							<span class="font-semibold text-primary">Estimated monthly support</span>
							<strong class="text-right text-xl font-bold tracking-[-0.04em] text-primary" data-fl-support-summary>
								{formatFloridaCurrency(initialResult.monthlySupport)}
							</strong>
						</div>
					</div>
				</div>

				<div class="mt-3 rounded-xl bg-surface-elevated/60 px-3 py-2 text-xs leading-5 text-secondary shadow-[inset_0_0_0_1px_var(--border-subtle)]">
					<p class="font-semibold text-primary" data-fl-overnight-status>Overnight threshold: under 73 nights (no credit)</p>
				</div>

				<div class="mt-3 grid gap-2 rounded-xl bg-surface-elevated/70 p-3 text-xs leading-5 text-secondary">
					<p class="font-semibold text-primary">How this estimate was calculated</p>
					<ul class="grid gap-1.5 pl-4 [list-style:disc]">
						<li>Both parents' net incomes are combined to look up the basic obligation from Florida's Income Shares schedule (Rule 12.902(e)).</li>
						<li>Parent B's share is proportional to their income as a fraction of combined income.</li>
						<li>Overnights of 73+ reduce support by 20%; 110+ reduces by 50%.</li>
						<li>Childcare and health insurance add-ons are split proportionally by income.</li>
					</ul>
				</div>

				<p class="mt-3 rounded-xl bg-surface/70 p-3 text-[11px] leading-4 text-muted shadow-[inset_0_0_0_1px_var(--border-subtle)]">
					This is an estimate based on Florida's Income Shares schedule. Your actual order may differ. Consult an attorney licensed in Florida.
				</p>

				<div class="mt-3">
					<a href="/overnight-custody-calculator/" class="inline-flex rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:opacity-90" style="color: #ffffff">
						Calculate your parenting time &rarr;
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import { trackGa4Event } from '../../lib/analytics/ga4';
	import {
		calculateFloridaChildSupport,
		formatFloridaCurrency,
		formatFloridaPercent,
	} from '../../lib/calculators/floridaChildSupport';

	document.querySelectorAll('[data-florida-child-support-calculator]').forEach((calculator) => {
		const form = calculator.querySelector('[data-fl-child-support-form]');
		const errorEl = calculator.querySelector('[data-fl-error]');
		const monthly = calculator.querySelector('[data-fl-support-monthly]');
		const summary = calculator.querySelector('[data-fl-support-summary]');
		const combinedIncome = calculator.querySelector('[data-fl-combined-income]');
		const basicObligation = calculator.querySelector('[data-fl-basic-obligation]');
		const parentBShare = calculator.querySelector('[data-fl-parent-b-share]');
		const baseObligation = calculator.querySelector('[data-fl-base-obligation]');
		const overnightRow = calculator.querySelector('[data-fl-overnight-row]');
		const overnightLabel = calculator.querySelector('[data-fl-overnight-label]');
		const overnightCredit = calculator.querySelector('[data-fl-overnight-credit]');
		const overnightStatus = calculator.querySelector('[data-fl-overnight-status]');
		const childcareRow = calculator.querySelector('[data-fl-childcare-row]');
		const childcareEl = calculator.querySelector('[data-fl-childcare]');
		const insuranceRow = calculator.querySelector('[data-fl-insurance-row]');
		const insuranceEl = calculator.querySelector('[data-fl-insurance]');
		const minimumNotice = calculator.querySelector('[data-fl-minimum-notice]');

		function showError(message: string) {
			if (!errorEl) return;
			errorEl.textContent = message;
			errorEl.classList.remove('hidden');
		}

		function clearError() {
			if (!errorEl) return;
			errorEl.textContent = '';
			errorEl.classList.add('hidden');
		}

		function update() {
			if (!(form instanceof HTMLFormElement)) return;
			const data = new FormData(form);

			try {
				const result = calculateFloridaChildSupport({
					netIncomeA: Number(data.get('netIncomeA')),
					netIncomeB: Number(data.get('netIncomeB')),
					numberOfChildren: Number(data.get('numberOfChildren')) as 1 | 2 | 3 | 4 | 5 | 6,
					parentBOvernights: Number(data.get('parentBOvernights')),
					monthlyChildcare: Number(data.get('monthlyChildcare')),
					monthlyHealthInsurance: Number(data.get('monthlyHealthInsurance')),
				});

				clearError();

				if (monthly) monthly.textContent = formatFloridaCurrency(result.monthlySupport);
				if (summary) summary.textContent = formatFloridaCurrency(result.monthlySupport);
				if (combinedIncome) combinedIncome.textContent = formatFloridaCurrency(result.combinedIncome);
				if (basicObligation) basicObligation.textContent = formatFloridaCurrency(result.basicObligation);
				if (parentBShare) parentBShare.textContent = formatFloridaPercent(result.parentBSharePct);
				if (baseObligation) baseObligation.textContent = formatFloridaCurrency(result.parentBBaseObligation);

				// Overnight credit row
				const hasCredit = result.overnightCredit > 0;
				overnightRow?.classList.toggle('hidden', !hasCredit);
				if (hasCredit && overnightLabel) {
					const label = result.overnightCreditType === 'extended'
						? 'Overnight credit (110+ nights, 50%)'
						: 'Overnight credit (73+ nights, 20%)';
					overnightLabel.textContent = label;
				}
				if (overnightCredit) overnightCredit.textContent = `-${formatFloridaCurrency(result.overnightCredit)}`;

				// Status badge
				if (overnightStatus) {
					if (result.overnightCreditType === 'extended') {
						overnightStatus.textContent = `Overnight threshold: 110+ nights — 50% extended credit applied`;
					} else if (result.overnightCreditType === 'standard') {
						overnightStatus.textContent = `Overnight threshold: 73–109 nights — 20% credit applied`;
					} else {
						overnightStatus.textContent = `Overnight threshold: under 73 nights (no credit)`;
					}
				}

				// Add-on rows
				childcareRow?.classList.toggle('hidden', result.parentBChildcare === 0);
				if (childcareEl) childcareEl.textContent = `+${formatFloridaCurrency(result.parentBChildcare)}`;

				insuranceRow?.classList.toggle('hidden', result.parentBHealthInsurance === 0);
				if (insuranceEl) insuranceEl.textContent = `+${formatFloridaCurrency(result.parentBHealthInsurance)}`;

				// Minimum notice
				minimumNotice?.classList.toggle('hidden', !result.minimumApplied);

			} catch (err) {
				showError(err instanceof Error ? err.message : 'Enter valid values to calculate.');
			}
		}

		form?.addEventListener('submit', (e) => {
			e.preventDefault();
			update();
			trackGa4Event('calculate_fl_child_support');
		});
		form?.addEventListener('input', update);
		form?.addEventListener('change', update);
		update();
	});
</script>
