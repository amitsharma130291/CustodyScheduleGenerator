---
import {
	calculateFLChildSupport,
} from '../../lib/calculators/floridaChildSupport';

const initialInput = {
	netIncomeA: 4000,
	netIncomeB: 3000,
	numberOfChildren: 2,
	overnightsA: 292,
	overnightsB: 73,
	qualifyingChildcare: 0,
	qualifyingChildHealthInsurance: 0,
	qualifyingNoncoveredMedical: 0,
	childcarePaidByA: 0,
	childcarePaidByB: 0,
	healthInsurancePaidByA: 0,
	healthInsurancePaidByB: 0,
	noncoveredMedicalPaidByA: 0,
	noncoveredMedicalPaidByB: 0,
} as const;

const initialResult = calculateFLChildSupport(initialInput);

function fmt(n: number) {
	return '$' + n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
}
---

<section id="fl-calculator" class="premium-card rounded-[1.6rem] p-3 sm:p-4" data-florida-child-support-calculator>
	<div class="rounded-[1.25rem] bg-surface-elevated p-3 shadow-[inset_0_1px_0_rgba(255,255,255,0.07)] sm:p-4">
		<div class="grid gap-4 xl:grid-cols-[0.92fr_1.08fr] xl:items-start">

			<!-- Inputs -->
			<div>
				<p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">Florida §61.30 Income Shares Calculator</p>
				<h2 class="mt-1.5 text-xl font-semibold tracking-[-0.04em] text-primary sm:text-2xl">Enter income &amp; parenting time</h2>
				<p class="mt-1.5 text-xs leading-4 text-muted">
					Use net monthly income after taxes, FICA, and health insurance premiums. Version FL-CS-2026.1.
				</p>

				<form class="mt-2.5 grid gap-2.5" data-fl-child-support-form>

					<label class="grid gap-0.5">
						<span class="text-sm font-medium text-secondary">Parent A net monthly income ($)</span>
						<input name="netIncomeA" type="number" min="0" step="0.01" value={initialInput.netIncomeA} inputmode="decimal"
							class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
					</label>

					<label class="grid gap-0.5">
						<span class="text-sm font-medium text-secondary">Parent B net monthly income ($)</span>
						<input name="netIncomeB" type="number" min="0" step="0.01" value={initialInput.netIncomeB} inputmode="decimal"
							class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
					</label>

					<label class="grid gap-0.5">
						<span class="text-sm font-medium text-secondary">Number of children</span>
						<select name="numberOfChildren" class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]">
							<option value="1">1 child</option>
							<option value="2" selected>2 children</option>
							<option value="3">3 children</option>
							<option value="4">4 children</option>
							<option value="5">5 children</option>
							<option value="6">6 children</option>
						</select>
					</label>

					<div class="grid grid-cols-2 gap-2">
						<label class="grid gap-0.5">
							<span class="text-sm font-medium text-secondary">Parent A overnights/year</span>
							<input name="overnightsA" type="number" min="0" max="365" step="1" value={initialInput.overnightsA} inputmode="numeric"
								class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
						</label>
						<label class="grid gap-0.5">
							<span class="text-sm font-medium text-secondary">Parent B overnights/year</span>
							<input name="overnightsB" type="number" min="0" max="365" step="1" value={initialInput.overnightsB} inputmode="numeric"
								class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
							<span class="text-[11px] leading-4 text-muted">73+ nights by both parents triggers substantial time-sharing.</span>
						</label>
					</div>

					<details class="group rounded-[1.1rem] bg-page/45 p-2.5 shadow-[inset_0_0_0_1px_var(--border-subtle)]">
						<summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold text-primary">
							Add-ons (childcare, insurance, medical)
							<span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-surface text-lg leading-none text-muted shadow-[inset_0_0_0_1px_var(--border-subtle)] transition-transform group-open:rotate-45">+</span>
						</summary>
						<div class="mt-3 grid gap-3">
							<div class="grid grid-cols-2 gap-2">
								<label class="grid gap-1">
									<span class="text-xs font-medium text-secondary">Childcare total/mo ($)</span>
									<input name="qualifyingChildcare" type="number" min="0" step="0.01" value="0" inputmode="decimal"
										class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
								</label>
								<label class="grid gap-1">
									<span class="text-xs font-medium text-secondary">A pays childcare ($)</span>
									<input name="childcarePaidByA" type="number" min="0" step="0.01" value="0" inputmode="decimal"
										class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
								</label>
							</div>
							<div class="grid grid-cols-2 gap-2">
								<label class="grid gap-1">
									<span class="text-xs font-medium text-secondary">Health insurance total/mo ($)</span>
									<input name="qualifyingChildHealthInsurance" type="number" min="0" step="0.01" value="0" inputmode="decimal"
										class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
								</label>
								<label class="grid gap-1">
									<span class="text-xs font-medium text-secondary">A pays health ins. ($)</span>
									<input name="healthInsurancePaidByA" type="number" min="0" step="0.01" value="0" inputmode="decimal"
										class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
								</label>
							</div>
							<div class="grid grid-cols-2 gap-2">
								<label class="grid gap-1">
									<span class="text-xs font-medium text-secondary">Noncovered medical total/mo ($)</span>
									<input name="qualifyingNoncoveredMedical" type="number" min="0" step="0.01" value="0" inputmode="decimal"
										class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
								</label>
								<label class="grid gap-1">
									<span class="text-xs font-medium text-secondary">A pays medical ($)</span>
									<input name="noncoveredMedicalPaidByA" type="number" min="0" step="0.01" value="0" inputmode="decimal"
										class="w-full min-w-0 rounded-xl bg-page px-3.5 py-2 text-sm text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]" />
								</label>
							</div>
							<p class="text-[11px] leading-4 text-muted">B's share = total minus A's portion. Expenses are allocated by income share after the cross-timeshare calculation.</p>
						</div>
					</details>

					<div class="hidden rounded-xl bg-red-50 px-3 py-2 text-xs text-red-700" data-fl-error></div>
				</form>
			</div>

			<!-- Results -->
			<div class="rounded-[1.35rem] bg-page/65 p-4 shadow-[inset_0_0_0_1px_var(--border-subtle)]" aria-live="polite">
				<p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">Estimated Monthly Support</p>
				<p class="mt-2 text-4xl font-bold leading-none tracking-[-0.06em] text-accent sm:text-5xl" data-fl-support-monthly>
					{fmt(initialResult.amount)}
				</p>
				<p class="mt-2 text-xs leading-5 text-muted" data-fl-direction>
					{initialResult.payer ? `Parent ${initialResult.payer} pays Parent ${initialResult.recipient}` : 'No transfer'} — planning estimate only.
				</p>

				<div class="mt-3 rounded-xl bg-surface-elevated/70 px-3 py-2 text-xs leading-5 text-secondary shadow-[inset_0_0_0_1px_var(--border-subtle)]">
					<p class="font-semibold text-primary" data-fl-timeshare-status>
						{initialResult.substantialTimesharing ? 'Substantial time-sharing: Yes (1.5× cross-timeshare method)' : 'Standard time-sharing (ordinary guideline)'}
					</p>
				</div>

				<!-- Calculation receipt (collapsible) -->
				<details class="mt-4 group">
					<summary class="flex cursor-pointer items-center justify-between gap-2 rounded-xl bg-surface-elevated/60 px-3 py-2 text-xs font-semibold text-primary shadow-[inset_0_0_0_1px_var(--border-subtle)]">
						Show calculation receipt
						<span class="text-muted transition-transform group-open:rotate-180">▾</span>
					</summary>
					<div class="mt-2 rounded-xl bg-surface-elevated/60 p-3 shadow-[inset_0_0_0_1px_var(--border-subtle)]">
						<ol class="grid gap-1.5 text-[11px] leading-5 text-secondary" data-fl-receipt>
							{initialResult.receipt.map(line => (
								<li class="flex items-start justify-between gap-3 border-b border-line-subtle pb-1 last:border-0 last:pb-0">
									<span>{line.split(':')[0]}</span>
									<strong class="shrink-0 text-right text-primary">{line.split(':').slice(1).join(':').trim()}</strong>
								</li>
							))}
						</ol>
					</div>
				</details>

				{initialResult.aboveTableWarning && (
					<div class="mt-3 rounded-xl bg-amber-50 px-3 py-2 text-[11px] leading-5 text-amber-800" data-fl-above-table-warning>
						{initialResult.aboveTableWarning}
					</div>
				)}

				<p class="mt-3 rounded-xl bg-surface/70 p-3 text-[11px] leading-4 text-muted shadow-[inset_0_0_0_1px_var(--border-subtle)]">
					Estimate based on Florida §61.30 guideline schedule (FL-CS-2026.1). Your actual order may differ. Consult a licensed Florida attorney.
				</p>

				<div class="mt-3">
					<a href="/overnight-custody-calculator/" class="inline-flex rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:opacity-90" style="color: #ffffff">
						Calculate your parenting time &rarr;
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import { trackGa4Event } from '../../lib/analytics/ga4';
	import { calculateFLChildSupport } from '../../lib/calculators/floridaChildSupport';

	document.querySelectorAll('[data-florida-child-support-calculator]').forEach((calculator) => {
		const form = calculator.querySelector('[data-fl-child-support-form]');
		const errorEl = calculator.querySelector('[data-fl-error]');
		const monthlyEl = calculator.querySelector('[data-fl-support-monthly]');
		const directionEl = calculator.querySelector('[data-fl-direction]');
		const timeshareStatusEl = calculator.querySelector('[data-fl-timeshare-status]');
		const receiptEl = calculator.querySelector('[data-fl-receipt]');
		const aboveTableWarningEl = calculator.querySelector('[data-fl-above-table-warning]');

		function fmt(n: number) {
			return '$' + n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
		}

		function renderReceipt(lines: string[]) {
			if (!receiptEl) return;
			receiptEl.innerHTML = lines.map(line => {
				const colonIdx = line.indexOf(':');
				const label = colonIdx >= 0 ? line.slice(0, colonIdx) : line;
				const value = colonIdx >= 0 ? line.slice(colonIdx + 1).trim() : '';
				return `<li class="flex items-start justify-between gap-3 border-b border-line-subtle pb-1 last:border-0 last:pb-0">
					<span>${label}</span>
					<strong class="shrink-0 text-right text-primary">${value}</strong>
				</li>`;
			}).join('');
		}

		function showError(message: string) {
			if (!errorEl) return;
			errorEl.textContent = message;
			errorEl.classList.remove('hidden');
		}

		function clearError() {
			if (!errorEl) return;
			errorEl.textContent = '';
			errorEl.classList.add('hidden');
		}

		function update() {
			if (!(form instanceof HTMLFormElement)) return;
			const data = new FormData(form);
			const g = (name: string) => Number(data.get(name)) || 0;

			try {
				const childcarePaidByA = g('childcarePaidByA');
				const qualifyingChildcare = g('qualifyingChildcare');
				const healthInsurancePaidByA = g('healthInsurancePaidByA');
				const qualifyingChildHealthInsurance = g('qualifyingChildHealthInsurance');
				const noncoveredMedicalPaidByA = g('noncoveredMedicalPaidByA');
				const qualifyingNoncoveredMedical = g('qualifyingNoncoveredMedical');

				const result = calculateFLChildSupport({
					netIncomeA: g('netIncomeA'),
					netIncomeB: g('netIncomeB'),
					numberOfChildren: Math.max(1, Math.min(6, Math.round(g('numberOfChildren')))),
					overnightsA: g('overnightsA'),
					overnightsB: g('overnightsB'),
					qualifyingChildcare,
					qualifyingChildHealthInsurance,
					qualifyingNoncoveredMedical,
					childcarePaidByA,
					childcarePaidByB: Math.max(0, qualifyingChildcare - childcarePaidByA),
					healthInsurancePaidByA,
					healthInsurancePaidByB: Math.max(0, qualifyingChildHealthInsurance - healthInsurancePaidByA),
					noncoveredMedicalPaidByA,
					noncoveredMedicalPaidByB: Math.max(0, qualifyingNoncoveredMedical - noncoveredMedicalPaidByA),
				});

				clearError();

				if (monthlyEl) monthlyEl.textContent = fmt(result.amount);
				if (directionEl) {
					directionEl.textContent = result.payer
						? `Parent ${result.payer} pays Parent ${result.recipient} — planning estimate only.`
						: 'No transfer — planning estimate only.';
				}
				if (timeshareStatusEl) {
					timeshareStatusEl.textContent = result.substantialTimesharing
						? 'Substantial time-sharing: Yes (1.5× cross-timeshare method)'
						: 'Standard time-sharing (ordinary guideline)';
				}

				renderReceipt(result.receipt);

				if (aboveTableWarningEl) {
					aboveTableWarningEl.textContent = result.aboveTableWarning ?? '';
					aboveTableWarningEl.classList.toggle('hidden', !result.aboveTableWarning);
				}

				trackGa4Event('calculate_fl_child_support');
			} catch (err) {
				showError(err instanceof Error ? err.message : 'Enter valid values to calculate.');
			}
		}

		form?.addEventListener('input', update);
		form?.addEventListener('change', update);
		update();
	});
</script>
