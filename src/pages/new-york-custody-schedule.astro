---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import FAQ from '../components/FAQ.astro';
import BackToGeneratorCta from '../components/BackToGeneratorCta.astro';
import { getCanonicalUrl } from '../lib/seo/metadata';
import { buildArticleSchema, buildBreadcrumbSchema, buildFAQSchema, buildWebPageSchema } from '../lib/seo/schema';

import ScheduleHeroGeneratorPanel from '../components/schedules/ScheduleHeroGeneratorPanel.astro';
import { generateSchedule } from '../lib/schedules/generateSchedule';
import { getDefaultStartDate } from '../lib/schedules/format';

const title = "New York Custody Schedule: Parenting-Time Options & Rules";
const description = "Compare New York custody schedule options, learn what courts consider, and build a parenting-time plan covering school, holidays, exchanges, and changes.";
const canonical = "/new-york-custody-schedule/";
const canonicalUrl = getCanonicalUrl(canonical);
const datePublished = "2026-08-13";
const dateModified = "2026-08-13";
const editorialReview = {
	reviewer: "CustodyBuilder Editorial Team",
	reviewerHref: "/about/",
	methodologyLabel: "How CustodyBuilder Works",
	methodologyHref: "/how-custodybuilder-works/",
	lastUpdatedLabel: "Last updated August 2026",
	disclaimer: "Educational information only. Not legal advice.",
	reviewedFor: [
		"Citation accuracy of New York Domestic Relations Law § 240",
		"New York Courts self-help guidance on custody, visitation, and modification",
		"Consistency with CustodyBuilder's schedule-generator patterns (2-2-3, 2-2-5-5, week-on/week-off)",
	],
};
const notAttorneyReviewed = "This page has not yet been reviewed by a licensed New York attorney. It reflects research against primary sources (New York Courts and the New York Domestic Relations Law) but should not be relied on as a substitute for legal advice.";
const breadcrumbs = [
	{ name: "Home", url: getCanonicalUrl("/") },
	{ name: "New York Custody Schedule", url: canonicalUrl },
];
const faqItems = [
	{ question: "Does New York favor 50/50 custody?", answer: "New York applies the child's-best-interests standard and does not impose one automatic parenting-time percentage. Equal time may work in a particular family, but it is not guaranteed merely because a parent requests it." },
	{ question: "At what age can a child choose which parent to live with in New York?", answer: "There is no single age at which a child alone decides custody. A court may give more weight to a mature child's reasoned preference, while still deciding the case under the broader best-interests standard." },
	{ question: "Is parenting time the same as legal custody?", answer: "No. Parenting time determines when a child is with a parent. Legal custody addresses authority over major decisions such as education and health care." },
	{ question: "Where can I get New York custody forms?", answer: "New York Courts provides custody, visitation, modification, and enforcement information and links to DIY programs. Court staff can explain procedure but cannot provide legal advice." },
];

const startDate = getDefaultStartDate();
const generatedSchedule = generateSchedule({
	scheduleId: '223',
	startDate,
	parentNames: { parentA: 'Parent A', parentB: 'Parent B' },
});
const heroTrustSignals = ['Free — no account needed', 'New York schedule builder', 'Download as PDF'];

const schema = [
	buildWebPageSchema({ name: title, description, url: canonicalUrl }),
	buildArticleSchema({ headline: title, description, url: canonicalUrl, datePublished, dateModified, authorName: editorialReview.reviewer }),
	buildFAQSchema(faqItems),
	buildBreadcrumbSchema(breadcrumbs),
];

const scheduleTable = [
	{ name: "2-2-3", how: "Two days with Parent A, two with B, then three with A; reverses next week", fits: "Younger children who benefit from frequent contact", pressure: "Many exchanges and changing weekdays" },
	{ name: "2-2-5-5", how: "Each parent has two fixed weekdays and alternating five-day blocks", fits: "School-age children; parents wanting stable weekdays", pressure: "Requires coordination across long weekends" },
	{ name: "Week-on/week-off", how: "Seven nights with each parent, commonly exchanging after school", fits: "Older children and nearby homes", pressure: "A week may feel long to young children" },
	{ name: "Alternating weekends + midweek", how: "One primary school-week home, with recurring time for the other parent", fits: "Longer commutes or unequal work availability", pressure: "Long gaps if the midweek contact is vague" },
	{ name: "School-year/summer split", how: "One parent has most school time; the other receives larger vacation blocks", fits: "Long-distance families", pressure: "Travel cost, missed activities, and holiday overlap" },
];

const drl240Points = [
	"The court must consider the effect of domestic violence proved by a preponderance of the evidence upon the child's best interests and other relevant people.",
	"A party's sex, sexual orientation, gender identity, or gender expression may not be used in the best-interest determination.",
	"The statute contains specific rules concerning certain homicide and sex-offense convictions.",
	"Military-service provisions address temporary custody changes, contact during service, leave parenting time, and review after return.",
	"Custody and parenting time remain governed by the child's best interests rather than an automatic parental time share.",
];

const buildSteps = [
	{ title: "1. Define the regular rotation precisely", body: "Use days, clock times, and exchange locations. “Alternating weekends” leaves unanswered whether the weekend begins Friday after school or Saturday morning and ends Sunday evening or Monday school drop-off." },
	{ title: "2. State which calendar controls", body: "Write an order of priority: (1) Holiday schedule, (2) School breaks and summer vacation, (3) Special events approved in writing, (4) Regular weekly schedule. Without a priority rule, Thanksgiving can collide with an ordinary weekend and generate two plausible readings." },
	{ title: "3. Use school as an exchange point when appropriate", body: "“Parent A's time begins at school dismissal” often reduces parent-to-parent contact and makes responsibility clear. Add a fallback for days when school is closed." },
	{ title: "4. Allocate transportation", body: "Specify who picks up, who drops off, where the child waits, how much lateness triggers notice, and whether a licensed third party may transport. Avoid “the parties will agree,” which converts every exchange into a new negotiation." },
	{ title: "5. Cover holidays, vacations, and travel", body: "Identify the exact holidays, start and end times, odd/even-year rotation, vacation-selection deadlines, passport custody, itinerary notice, and whether holiday time overrides the normal schedule." },
	{ title: "6. Address communication and information", body: "Set reasonable child-parent calls during longer separations. Require both parents to share school notices, medical information, and emergency contacts directly rather than through the child." },
	{ title: "7. Add a change process", body: "For small swaps, require written confirmation in a co-parenting app, email, or text and state that an occasional swap does not permanently amend the order. For recurring changes, use a signed stipulation submitted for court approval or seek modification." },
];

const mistakes = [
	"Calling joint legal custody “50/50 custody” without defining decision-making or time",
	"Counting nights but ignoring school transportation",
	"Writing “reasonable visitation” when the parents already disagree",
	"Omitting a school-closed exchange fallback",
	"Forgetting that holiday time overrides the weekly rotation only if the order says so",
	"Giving a child unilateral power to cancel time instead of considering age-appropriate input",
	"Treating child support and parenting time as bargaining chips; they are separate legal issues",
];

const checklist = [
	"Legal decision-making authority is clear",
	"Every regular exchange has a day, time, and location",
	"School-closed days have a fallback",
	"Holiday priority and odd/even years are defined",
	"Summer-selection deadlines prevent conflicting requests",
	"Transportation and lateness rules are workable",
	"Calls and information sharing are age-appropriate",
	"Safety restrictions are specific, if needed",
	"Relocation and travel notice follow applicable law and the order",
	"The schedule has been tested on a 12-month calendar",
];
---
<BaseLayout title={title} description={description} canonical={canonical} ogType="article">
	<JsonLd slot="head" data={schema} />
	<Navbar />
	<Breadcrumbs items={breadcrumbs} />
	<main class="overflow-x-clip">
		<section class="container-shell grid grid-cols-1 gap-5 py-4 sm:py-5 lg:grid-cols-[minmax(0,0.88fr)_minmax(704px,1.12fr)] lg:items-start lg:gap-7 lg:py-6 xl:w-[min(100%,1360px)]" id="schedule-generator">
			<div class="order-1 min-w-0 lg:col-start-1 lg:row-start-1 lg:pt-1">
				<p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">New York custody schedule guide</p>
				<h1 class="mt-2.5 max-w-3xl text-[1.7rem] font-semibold leading-[1.06] tracking-[-0.05em] text-primary sm:text-4xl lg:text-5xl">New York Custody Schedule: How to Build a Parenting-Time Plan That Works</h1>
				<div class="mt-4 max-w-3xl rounded-[1.25rem] border border-line bg-accent/10 p-5">
					<p class="text-sm font-semibold text-primary">Featured answer</p>
					<p class="mt-2 text-sm leading-6 text-secondary">A New York custody schedule should state exactly when the child is with each parent, how exchanges work, and what happens when holidays, school breaks, travel, illness, or delays interrupt the normal rotation. New York does not impose one statewide schedule or automatically require 50/50 time &mdash; a judge must base any custody order on the child's best interests.</p>
				</div>
				<div class="mt-4 max-w-3xl rounded-2xl bg-surface/70 px-4 py-3 text-sm leading-6 text-secondary shadow-[inset_0_0_0_1px_var(--border-subtle)]"><strong class="text-primary">Planning rule:</strong> If two reasonable adults could read a provision differently, make it more specific before signing it.</div>
				<div class="mt-6 max-w-2xl text-xs leading-5 text-muted">
					<p class="font-semibold text-secondary">Reviewed for:</p>
					<ul class="mt-1 list-inside list-disc">{editorialReview.reviewedFor.map((i) => <li>{i}</li>)}</ul>
					<p class="mt-2">Reviewed by <a href={editorialReview.reviewerHref} class="font-semibold text-secondary underline">{editorialReview.reviewer}</a>{' · '}<a href={editorialReview.methodologyHref} class="font-semibold text-secondary underline">{editorialReview.methodologyLabel}</a>{' · '}<span class="font-semibold text-secondary">{editorialReview.lastUpdatedLabel}</span>{' · '}{editorialReview.disclaimer}</p>
				</div>
				<div class="mt-4 max-w-2xl rounded-2xl bg-amber-50 border border-amber-300 px-4 py-3 text-xs leading-5 text-secondary dark:bg-amber-900/20 dark:border-amber-700"><strong class="text-primary">Attorney review notice:</strong> {notAttorneyReviewed}</div>
				<div class="mt-6 flex flex-wrap gap-3">
					<a href="/custody-schedule-generator/" class="inline-flex rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:opacity-90" style="color: #ffffff">Build your New York schedule free &rarr;</a>
					<a href="/2-2-3-custody-schedule/" class="inline-flex rounded-full bg-surface px-5 py-2.5 text-sm font-semibold text-accent shadow-[inset_0_0_0_1px_var(--border-subtle)] hover:text-primary">2-2-3 schedule</a>
					<a href="/week-on-week-off-custody-schedule/" class="inline-flex rounded-full bg-surface px-5 py-2.5 text-sm font-semibold text-accent shadow-[inset_0_0_0_1px_var(--border-subtle)] hover:text-primary">Week-on/week-off</a>
					<a href="/holiday-custody-schedule/" class="inline-flex rounded-full bg-surface px-5 py-2.5 text-sm font-semibold text-accent shadow-[inset_0_0_0_1px_var(--border-subtle)] hover:text-primary">Holiday custody schedule</a>
				</div>
			</div>

			<ScheduleHeroGeneratorPanel selectedScheduleId="223" generatedSchedule={generatedSchedule} heroTrustSignals={heroTrustSignals} />
		</section>

		<nav class="container-shell border-y border-line-subtle py-3 lg:max-w-5xl" aria-label="On this page">
			<ul class="flex flex-wrap gap-x-4 gap-y-1 text-xs font-semibold text-secondary">
				<li><a href="#legal-vs-physical" class="hover:text-accent">Legal vs. physical</a></li>
				<li><a href="#schedules" class="hover:text-accent">Common schedules</a></li>
				<li><a href="#drl-240" class="hover:text-accent">What DRL §240 requires</a></li>
				<li><a href="#build" class="hover:text-accent">Building a complete schedule</a></li>
				<li><a href="#example" class="hover:text-accent">Worked example</a></li>
				<li><a href="#modification" class="hover:text-accent">Can it be changed?</a></li>
				<li><a href="#mistakes" class="hover:text-accent">Common mistakes</a></li>
				<li><a href="#checklist" class="hover:text-accent">Checklist</a></li>
				<li><a href="#faq" class="hover:text-accent">FAQ</a></li>
			</ul>
		</nav>

		<section id="legal-vs-physical" class="container-shell scroll-mt-24 border-t border-line-subtle py-10 lg:max-w-5xl lg:py-12">
			<h2 class="text-2xl font-semibold text-primary sm:text-3xl">Legal Custody and Physical Custody Answer Different Questions</h2>
			<p class="mt-3 max-w-3xl text-secondary">New York courts distinguish between <strong class="text-primary">legal custody</strong> &mdash; responsibility for major decisions &mdash; and <strong class="text-primary">physical or residential custody</strong> &mdash; where the child primarily lives. Parenting time, also called visitation, describes time with a parent who does not have primary physical custody. These concepts can be combined in several ways; joint legal custody does not necessarily mean equal overnights.</p>
			<p class="mt-3 max-w-3xl text-secondary">New York courts say neither parent receives preference simply because that parent is the mother or father. The controlling standard is the child's best interests. Relevant considerations can include each parent's caregiving ability, the child's relationship with each parent, stability, health, work schedules, domestic violence, and each parent's willingness to support the child's relationship with the other parent. No single calendar percentage decides the case.</p>
		</section>

		<section id="schedules" class="container-shell scroll-mt-24 border-t border-line-subtle py-10 lg:max-w-5xl lg:py-12">
			<h2 class="text-2xl font-semibold text-primary sm:text-3xl">Common New York Parenting-Time Schedules</h2>
			<div class="mt-6 max-w-3xl overflow-x-auto rounded-[1.5rem] ring-1 ring-line-subtle">
				<table class="w-full min-w-[640px] text-left text-sm">
					<thead class="bg-surface-elevated text-primary"><tr><th class="px-4 py-3 font-semibold">Schedule</th><th class="px-4 py-3 font-semibold">How it works</th><th class="px-4 py-3 font-semibold">Often fits</th><th class="px-4 py-3 font-semibold">Pressure point</th></tr></thead>
					<tbody class="divide-y divide-line-subtle text-secondary">{scheduleTable.map((row) => (<tr><td class="px-4 py-3 font-semibold text-primary">{row.name}</td><td class="px-4 py-3">{row.how}</td><td class="px-4 py-3">{row.fits}</td><td class="px-4 py-3">{row.pressure}</td></tr>))}</tbody>
				</table>
			</div>
			<p class="mt-4 max-w-3xl text-sm text-secondary">Equal time is not a single pattern. A <a href="/2-2-3-custody-schedule/" class="font-semibold text-accent underline decoration-line underline-offset-4 hover:text-primary">2-2-3 schedule</a> and <a href="/week-on-week-off-custody-schedule/" class="font-semibold text-accent underline decoration-line underline-offset-4 hover:text-primary">week-on/week-off schedule</a> can both approach 50/50, yet create very different childhood routines.</p>
		</section>

		<section id="drl-240" class="container-shell scroll-mt-24 border-t border-line-subtle py-10 lg:max-w-5xl lg:py-12">
			<h2 class="text-2xl font-semibold text-primary sm:text-3xl">What DRL §240 Requires &mdash; and What Comes From Broader Best-Interest Law</h2>
			<p class="mt-3 max-w-3xl text-secondary">New York Domestic Relations Law §240 does not provide one neat, exhaustive checklist comparable to some states' statutes. Presenting a generic internet list as "the §240 factors" would be inaccurate. The statute expressly directs or limits the court in several important ways:</p>
			<ul class="mt-4 max-w-3xl space-y-2 text-sm leading-6 text-secondary">
				{drl240Points.map((point) => (<li class="flex gap-2"><span class="shrink-0 text-accent" aria-hidden="true">&rarr;</span>{point}</li>))}
			</ul>
			<p class="mt-4 max-w-3xl text-secondary">New York Courts' public guidance and appellate decisions identify the broader circumstances judges evaluate: each caregiver's ability and past performance, stability, the child's relationships and wishes, health and safety, work schedules and child care, the homes' practical fit, and each parent's ability to support the other safe parent-child relationship. The weight changes with the evidence; the inquiry is not a point system.</p>
			<p class="mt-4 max-w-3xl text-secondary">For schedule design, these legal principles become operational questions: Can the child reach school and treatment from both homes? Who handles the recurring Tuesday activity? How many handoffs does the plan create? A mathematically equal proposal that adds ten weekly hours in a car may serve the child less well than a schedule with fewer school-night transitions and larger vacation blocks.</p>
		</section>

		<section id="build" class="container-shell scroll-mt-24 border-t border-line-subtle py-10 lg:max-w-5xl lg:py-12">
			<h2 class="text-2xl font-semibold text-primary sm:text-3xl">A Complete New York Custody Schedule Needs More Than Weekdays</h2>
			<div class="mt-6 max-w-3xl space-y-4">
				{buildSteps.map((step) => (<div class="rounded-[1.25rem] bg-surface/70 p-5 shadow-[inset_0_0_0_1px_var(--border-subtle)]"><p class="font-semibold text-primary">{step.title}</p><p class="mt-2 text-sm leading-6 text-secondary">{step.body}</p></div>))}
			</div>
			<p class="mt-4 max-w-3xl text-sm text-secondary">Use the <a href="/holiday-custody-schedule/" class="font-semibold text-accent underline decoration-line underline-offset-4 hover:text-primary">holiday custody schedule guide</a> to identify collisions before they happen.</p>
		</section>

		<section id="example" class="container-shell scroll-mt-24 border-t border-line-subtle py-10 lg:max-w-5xl lg:py-12">
			<h2 class="text-2xl font-semibold text-primary sm:text-3xl">Worked Example: Test the Schedule Against a Real School Week</h2>
			<div class="mt-4 max-w-3xl rounded-[1.25rem] bg-surface/70 p-5 shadow-[inset_0_0_0_1px_var(--border-subtle)]">
				<p class="text-secondary">Assume an eight-year-old attends school Monday through Friday, has soccer Tuesday, and receives reading support Thursday. Parent A lives ten minutes from school; Parent B lives 25 minutes away.</p>
				<p class="mt-3 text-sm leading-6 text-secondary">A 2-2-5-5 plan can give Parent A every Monday and Tuesday and Parent B every Wednesday and Thursday, with alternating weekends. It creates stable activity ownership, but only if the plan identifies who transports on the Tuesday soccer night and shares Thursday reading updates. The pattern name does not solve those operational details.</p>
				<p class="mt-3 text-sm leading-6 text-secondary">Build the rotation in the <a href="/custody-schedule-generator/" class="font-semibold text-accent underline decoration-line underline-offset-4 hover:text-primary">custody schedule generator</a>, overlay school breaks, and then count exchanges &mdash; not just overnights. Use the <a href="/custody-percentage-calculator/" class="font-semibold text-accent underline decoration-line underline-offset-4 hover:text-primary">custody percentage calculator</a> only as a measurement tool; percentage alone does not establish best interests.</p>
			</div>
		</section>

		<section id="modification" class="container-shell scroll-mt-24 border-t border-line-subtle py-10 lg:max-w-5xl lg:py-12">
			<h2 class="text-2xl font-semibold text-primary sm:text-3xl">Can a New York Custody Schedule Be Changed?</h2>
			<p class="mt-3 max-w-3xl text-secondary">Yes. New York Courts explains that a parent seeking modification must show changed circumstances and that the requested change is in the child's best interests. Family Court offers a Custody/Visitation Modification DIY program for eligible users. If the problem is that the other parent is violating the existing order &mdash; not that the order itself no longer works &mdash; <a href="/how-to-modify-custody-order/" class="font-semibold text-accent underline decoration-line underline-offset-4 hover:text-primary">enforcement may be the correct request instead of modification</a>.</p>
			<div class="mt-4 max-w-3xl rounded-2xl bg-surface/70 px-4 py-3 text-sm leading-6 text-secondary shadow-[inset_0_0_0_1px_var(--border-subtle)]">A private handshake may work socially while leaving the original court order enforceable. Permanent changes are safer when documented and submitted through the appropriate court process.</div>
		</section>

		<section id="mistakes" class="container-shell scroll-mt-24 border-t border-line-subtle py-10 lg:max-w-5xl lg:py-12">
			<h2 class="text-2xl font-semibold text-primary sm:text-3xl">Mistakes That Create Avoidable Disputes</h2>
			<ul class="mt-6 max-w-3xl space-y-2 text-sm leading-6 text-secondary">
				{mistakes.map((item) => (<li class="flex gap-2 rounded-[1.25rem] bg-surface/70 p-4 shadow-[inset_0_0_0_1px_var(--border-subtle)]"><span class="shrink-0 text-accent" aria-hidden="true">&rarr;</span>{item}</li>))}
			</ul>
		</section>

		<section id="checklist" class="container-shell scroll-mt-24 border-t border-line-subtle py-10 lg:max-w-5xl lg:py-12">
			<h2 class="text-2xl font-semibold text-primary sm:text-3xl">New York Custody Schedule Checklist</h2>
			<ul class="mt-6 max-w-3xl grid gap-2 sm:grid-cols-2">
				{checklist.map((item) => (<li class="flex gap-2 text-sm leading-6 text-secondary"><span class="shrink-0 text-accent" aria-hidden="true">&#9744;</span>{item}</li>))}
			</ul>
			<div class="mt-8 max-w-3xl grid gap-4 sm:grid-cols-2">
				<a href="/custody-schedule-generator/" class="rounded-[1.25rem] bg-surface/70 p-5 shadow-[inset_0_0_0_1px_var(--border-subtle)] hover:shadow-md transition-shadow"><p class="font-semibold text-accent">Custody Schedule Generator</p><p class="mt-2 text-sm leading-6 text-secondary">Build your New York schedule visually and download as PDF, free.</p></a>
				<a href="/parenting-plan-template/" class="rounded-[1.25rem] bg-surface/70 p-5 shadow-[inset_0_0_0_1px_var(--border-subtle)] hover:shadow-md transition-shadow"><p class="font-semibold text-accent">Parenting Plan Template</p><p class="mt-2 text-sm leading-6 text-secondary">Document decision-making, transportation, and holiday terms.</p></a>
			</div>
			<div class="mt-8"><BackToGeneratorCta /></div>
		</section>

		<FAQ items={faqItems} title="New York Custody Schedule — Frequently Asked Questions" description="Common questions about New York custody law, parenting time, and modification." />

		<section class="container-shell border-t border-line-subtle py-8 lg:max-w-5xl">
			<h2 class="text-lg font-semibold text-primary">Sources</h2>
			<ol class="mt-3 space-y-2 text-xs text-muted">
				<li>[1] New York Courts, About Custody &mdash; nycourts.gov/help/family-issues-divorce/about-custody &mdash; last verified August 13, 2026</li>
				<li>[2] New York Courts, Best Interest of the Child &mdash; nycourts.gov/help/family-issues-divorce/best-interest-child &mdash; last verified August 13, 2026</li>
				<li>[3] New York Courts, Custody & Visitation Orders &mdash; nycourts.gov/help/family-issues-divorce/custody-visitation-orders &mdash; last verified August 13, 2026</li>
				<li>[4] New York Domestic Relations Law § 240 &mdash; nysenate.gov/legislation/laws/DOM/240 &mdash; last verified August 13, 2026</li>
			</ol>
		</section>
		<section class="container-shell border-t border-line-subtle py-8 lg:max-w-5xl">
			<p class="max-w-3xl text-xs leading-5 text-muted">This page provides general planning and educational information, not legal advice. New York custody outcomes depend on the facts, existing orders, court, and current law. This page has not been reviewed by a licensed New York attorney. Seek a New York family-law attorney for advice about your case, especially where safety, relocation, interstate jurisdiction, or emergency relief is involved.</p>
		</section>
	</main>
	<Footer />
</BaseLayout>
