<script>
	import { deliverPdfByEmail, getEntitlement, base64ToUint8Array } from '../lib/payments/dodoCheckout';

	function track(eventName, extra = {}) {
		if (typeof window.gtag === 'function') {
			window.gtag('event', eventName, extra);
		}
	}

	const offerPageRoot = document.querySelector('.offer-page');
	const showIfOwned = document.querySelectorAll('[data-show-if-owned]');
	const stickyBar = document.querySelector('[data-sticky-cta]');
	const alreadyOwnsChecklist = Boolean(getEntitlement('two-home'));

	// A visitor could land here again later (bookmark, back button) after
	// already buying the add-on — swap the pitch for a plain "you own this"
	// notice instead of asking them to buy twice. The calendar-ready
	// confirmation card is NOT part of [data-hide-if-owned] — it stays
	// visible either way, since it's true regardless of the add-on decision.
	if (alreadyOwnsChecklist) {
		offerPageRoot?.classList.add('owns-checklist');
		showIfOwned.forEach((el) => el.classList.remove('hidden'));
		stickyBar?.remove();
	} else {
		track('two_home_upsell_viewed');
	}

	// --- CTA click tracking + duplicate-click guard -----------------------
	document.querySelectorAll('[data-cta]').forEach((el) => {
		if (!(el instanceof HTMLElement)) return;
		const position = el.dataset.cta ?? '';
		const label = el.querySelector('[data-cta-label]');
		let clicked = false;
		el.addEventListener('click', (event) => {
			if (clicked) {
				event.preventDefault();
				return;
			}
			clicked = true;
			el.classList.add('is-loading');
			el.setAttribute('aria-busy', 'true');
			el.setAttribute('aria-disabled', 'true');
			if (label) label.textContent = 'Adding your checklist…';
			track(position === 'final' ? 'two_home_final_cta_click' : 'two_home_hero_cta_click', { source: position });
		});
	});

	// Both decline links go straight back to the calendar.
	document.querySelectorAll('[data-decline]').forEach((el) => {
		el.addEventListener('click', () => {
			track('two_home_decline_click', { position: el.getAttribute('data-decline') ?? '' });
		});
	});

	// --- Sample pages modal: accessible dialog with a real focus trap ------
	const modalBackdrop = document.querySelector('[data-preview-modal-backdrop]');
	const modal = document.querySelector('[data-preview-modal]');
	const modalCloseButton = document.querySelector('[data-preview-modal-close]');
	const openPreviewButtons = document.querySelectorAll('[data-open-preview]');
	let modalTrigger = null;

	function getFocusableInModal() {
		if (!(modal instanceof HTMLElement)) return [];
		return Array.from(modal.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'));
	}

	function openPreviewModal(trigger) {
		if (!(modalBackdrop instanceof HTMLElement)) return;
		modalTrigger = trigger ?? null;
		modalBackdrop.classList.remove('hidden');
		document.body.style.overflow = 'hidden';
		track('two_home_printable_preview_opened');
		window.setTimeout(() => {
			if (modalCloseButton instanceof HTMLElement) modalCloseButton.focus();
		}, 0);
		document.addEventListener('keydown', handleModalKeydown);
	}

	function closePreviewModal() {
		if (!(modalBackdrop instanceof HTMLElement) || modalBackdrop.classList.contains('hidden')) return;
		modalBackdrop.classList.add('hidden');
		document.body.style.overflow = '';
		document.removeEventListener('keydown', handleModalKeydown);
		track('two_home_printable_preview_closed');
		if (modalTrigger instanceof HTMLElement) modalTrigger.focus();
		modalTrigger = null;
	}

	function handleModalKeydown(event) {
		if (event.key === 'Escape') {
			event.preventDefault();
			closePreviewModal();
			return;
		}
		if (event.key !== 'Tab') return;
		const focusable = getFocusableInModal();
		if (!focusable.length) return;
		const first = focusable[0];
		const last = focusable[focusable.length - 1];
		if (event.shiftKey && document.activeElement === first) {
			event.preventDefault();
			last.focus();
		} else if (!event.shiftKey && document.activeElement === last) {
			event.preventDefault();
			first.focus();
		}
	}

	openPreviewButtons.forEach((button) => {
		button.addEventListener('click', () => openPreviewModal(button));
	});
	modalCloseButton?.addEventListener('click', closePreviewModal);
	modalBackdrop?.addEventListener('click', (event) => {
		if (event.target === modalBackdrop) closePreviewModal();
	});

	// --- Mobile sticky CTA -------------------------------------------------
	// Visible only below 900px, only once the hero CTA has scrolled out of
	// view, and hidden again whenever either the hero or the final CTA is
	// back in view — so it never sits redundantly beside a CTA the visitor
	// can already see, and never covers the decline link below it.
	if (stickyBar instanceof HTMLElement && !alreadyOwnsChecklist) {
		const heroCta = document.querySelector('[data-cta="hero"]');
		const finalCta = document.querySelector('[data-cta="final"]');
		let heroVisible = true;
		let finalVisible = false;

		function isMobileViewport() {
			return window.matchMedia('(max-width: 899px)').matches;
		}
		function updateStickyVisibility() {
			const shouldShow = isMobileViewport() && !heroVisible && !finalVisible;
			stickyBar.classList.toggle('is-hidden', !shouldShow);
			document.body.classList.toggle('has-offer-sticky-cta', shouldShow);
		}

		if (heroCta && finalCta && 'IntersectionObserver' in window) {
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.target === heroCta) heroVisible = entry.isIntersecting;
						if (entry.target === finalCta) finalVisible = entry.isIntersecting;
					}
					updateStickyVisibility();
				},
				{ threshold: 0 },
			);
			observer.observe(heroCta);
			observer.observe(finalCta);
		}
		window.addEventListener('resize', updateStickyVisibility, { passive: true });
	}

	/** Finishes emailing the calendar PDF that YearCalendarPanel.astro already built and downloaded locally before redirecting here — deferred so that redirect wasn't blocked on a network round trip. This page states the calendar has already been emailed as settled fact (the send is kicked off immediately below); this call is what actually makes that true. */
	async function deliverPendingCalendarEmail() {
		const raw = window.sessionStorage.getItem('cb_pending_calendar_email');
		if (!raw) return;
		window.sessionStorage.removeItem('cb_pending_calendar_email');

		let pending;
		try {
			pending = JSON.parse(raw);
		} catch {
			return;
		}
		if (!pending?.paymentId || !pending?.pdfBase64) return;

		try {
			const bytes = base64ToUint8Array(pending.pdfBase64);
			await deliverPdfByEmail(pending.paymentId, bytes, pending.scheduleName);
		} catch (error) {
			console.error('Failed to email the calendar PDF from the offer page:', error);
		}
	}

	deliverPendingCalendarEmail();
</script>
