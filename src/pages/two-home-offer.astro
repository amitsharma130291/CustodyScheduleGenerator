							<li><span class="doc-checkbox" aria-hidden="true"></span>Pajamas</li>
							<li><span class="doc-checkbox" aria-hidden="true"></span>Underwear &amp; socks</li>
							<li><span class="doc-checkbox" aria-hidden="true"></span>Everyday outfit</li>
							<li><span class="doc-checkbox" aria-hidden="true"></span>Basic toiletries</li>
						</ul>
					</div>
				</div>
				<div class="doc-page doc-page-modal">
					<div class="doc-page-inner">
						<p class="doc-page-title">What Travels</p>
						<ul class="doc-page-rows">
							<li><span class="doc-checkbox" aria-hidden="true"></span>School backpack</li>
							<li><span class="doc-checkbox" aria-hidden="true"></span>Water bottle</li>
							<li><span class="doc-checkbox" aria-hidden="true"></span>Daily medication</li>
							<li><span class="doc-checkbox" aria-hidden="true"></span>Glasses, if worn</li>
							<li><span class="doc-checkbox" aria-hidden="true"></span>Comfort item</li>
