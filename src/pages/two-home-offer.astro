						<ul class="doc-page-rows">
							<li><span class="doc-checkbox" aria-hidden="true"></span>Soccer or activity gear</li>
							<li><span class="doc-checkbox" aria-hidden="true"></span>Lunch box or snacks</li>
							<li><span class="doc-checkbox" aria-hidden="true"></span>Homework for the week</li>
