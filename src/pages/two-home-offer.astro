	<!-- Mobile sticky CTA — shown once the visitor scrolls past the hero CTA, hidden again whenever the hero or final CTA is back in view. -->
	<div class="sticky-cta-bar is-hidden" data-sticky-cta>
		<a href="/two-home-checklist/" class="offer-cta" style="min-height: 3.25rem; font-size: 0.9rem" data-cta="sticky">
			<span data-cta-label>Add My Personalized Checklist — $7 once</span>
		</a>
