---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import FAQ from '../components/FAQ.astro';
import { getCanonicalUrl } from '../lib/seo/metadata';
import { buildArticleSchema, buildBreadcrumbSchema, buildFAQSchema, buildWebPageSchema } from '../lib/seo/schema';
import {
	beforeContact,
	canHelp,
	cannotHelp,
	correctionProcess,
	faqItems,
	faqSection,
	hero,
	meta,
} from '../data/contactPage';

const canonical = '/contact/';
const canonicalUrl = getCanonicalUrl(canonical);
const breadcrumbs = [
	{ name: 'Home', url: getCanonicalUrl('/') },
	{ name: 'Contact', url: canonicalUrl },
];
const schema = [
	buildWebPageSchema({ name: meta.title, description: meta.description, url: canonicalUrl }),
	buildArticleSchema({
		headline: hero.headline,
		description: meta.description,
		url: canonicalUrl,
		datePublished: '2026-06-01',
		dateModified: meta.dateModified,
		authorName: 'CustodyBuilder Editorial Team',
	}),
	buildFAQSchema(faqItems),
	buildBreadcrumbSchema(breadcrumbs),
];
---

<BaseLayout title={meta.title} description={meta.description} canonical={canonical}>
	<JsonLd slot="head" data={schema} />
	<Navbar />
	<Breadcrumbs items={breadcrumbs} />
	<main>
		<section class="container-shell py-10 lg:py-14">
			<div class="max-w-3xl">
				<h1 class="text-4xl font-semibold leading-[0.98] tracking-[-0.055em] text-primary sm:text-5xl">{hero.headline}</h1>
				<p class="mt-5 text-lg leading-8 text-secondary">
					Use the form below to send tool bugs, calculator discrepancies, export issues, correction requests, or editorial feedback.
					Do not send confidential case details or requests for legal advice.
				</p>
			</div>
		</section>

		{/* ------------------------------------------------------------------ */}
		{/* Contact form                                                         */}
		{/* ------------------------------------------------------------------ */}
		<section class="container-shell scroll-mt-24 border-t border-line-subtle py-10 lg:py-12">
			<h2 class="text-2xl font-semibold text-primary sm:text-3xl">Send a Message</h2>
			<p class="mt-2 max-w-xl text-sm text-secondary">
				Required fields are marked with an asterisk (*). We do not reply to legal advice requests.
			</p>

			<form
				id="contact-form"
				class="mt-8 max-w-xl space-y-6"
				method="POST"
				action="/api/contact"
				novalidate
			>
				{/* Honeypot — hidden from real users, bots fill it */}
				<div style="position:absolute;left:-9999px;top:-9999px;width:1px;height:1px;overflow:hidden" aria-hidden="true">
					<label for="website">Leave this blank</label>
					<input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
				</div>

				{/* Timing signal */}
				<input type="hidden" name="form_time" id="form_time" value="" />

				{/* Auto-filled page URL */}
				<input type="hidden" name="page_url" id="page_url" value="" />

				{/* Name (optional) */}
				<div>
					<label for="name" class="block text-sm font-medium text-primary">Name <span class="text-secondary font-normal">(optional)</span></label>
					<input
						type="text"
						id="name"
						name="name"
						autocomplete="name"
						maxlength="200"
						class="mt-1.5 block w-full rounded-lg border border-line bg-surface px-3.5 py-2.5 text-sm text-primary placeholder:text-secondary/60 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
						placeholder="Your name"
					/>
				</div>

				{/* Email (required) */}
				<div>
					<label for="email" class="block text-sm font-medium text-primary">Email address *</label>
					<input
						type="email"
						id="email"
						name="email"
						required
						autocomplete="email"
						maxlength="254"
						class="mt-1.5 block w-full rounded-lg border border-line bg-surface px-3.5 py-2.5 text-sm text-primary placeholder:text-secondary/60 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
						placeholder="you@example.com"
					/>
					<p class="mt-1 text-xs text-secondary">We will use this address to reply. It becomes the Reply-To on our end.</p>
				</div>

				{/* Message (required) */}
				<div>
					<label for="message" class="block text-sm font-medium text-primary">Message *</label>
					<textarea
						id="message"
						name="message"
						required
						minlength="10"
						maxlength="5000"
						rows="6"
						class="mt-1.5 block w-full rounded-lg border border-line bg-surface px-3.5 py-2.5 text-sm text-primary placeholder:text-secondary/60 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent resize-y"
						placeholder="Describe the bug, discrepancy, or feedback — include page URL, browser, and reproduction steps if relevant."
					></textarea>
					<p class="mt-1 text-xs text-secondary" id="message-count">10–5,000 characters.</p>
				</div>

				{/* Status area */}
				<div id="form-status" role="alert" aria-live="polite" aria-atomic="true" class="hidden rounded-lg px-4 py-3 text-sm"></div>

				{/* Submit */}
				<div>
					<button
						type="submit"
						id="submit-btn"
						class="btn-primary inline-flex h-11 items-center justify-center rounded-full px-6 text-sm font-semibold disabled:opacity-60 disabled:cursor-not-allowed"
					>
						Send message
					</button>
				</div>
			</form>
		</section>

		{/* ------------------------------------------------------------------ */}
		{/* What we can help with                                               */}
		{/* ------------------------------------------------------------------ */}
		<section class="container-shell scroll-mt-24 border-t border-line-subtle py-10 lg:py-12">
			<h2 class="text-2xl font-semibold text-primary sm:text-3xl">{canHelp.title}</h2>
			<ul class="mt-6 max-w-3xl space-y-4">
				{canHelp.items.map((item) => (
					<li class="border-l-2 border-accent/30 pl-4">
						<h3 class="font-semibold text-primary">{item.heading}</h3>
						<p class="mt-2 text-sm text-secondary">{item.body}</p>
					</li>
				))}
			</ul>
		</section>

		<section class="container-shell scroll-mt-24 border-t border-line-subtle py-10 lg:py-12">
			<h2 class="text-2xl font-semibold text-primary sm:text-3xl">{cannotHelp.title}</h2>
			<ul class="mt-6 max-w-3xl space-y-4">
				{cannotHelp.items.map((item) => (
					<li class="border-l-2 border-line pl-4">
						<h3 class="font-semibold text-primary">{item.heading}</h3>
						<p class="mt-2 text-sm text-secondary">{item.body}</p>
					</li>
				))}
			</ul>
		</section>

		<section class="container-shell scroll-mt-24 border-t border-line-subtle py-10 lg:py-12">
			<h2 class="text-2xl font-semibold text-primary sm:text-3xl">{beforeContact.title}</h2>
			<p class="mt-3 max-w-3xl text-secondary">{beforeContact.intro}</p>
			<ul class="mt-6 max-w-3xl space-y-3">
				{beforeContact.links.map((link) => (
					<li>
						<a href={link.href} class="font-semibold text-accent underline">{link.label}</a>
						<span class="text-sm text-secondary"> — {link.detail}</span>
					</li>
				))}
			</ul>
		</section>

		<section class="container-shell scroll-mt-24 border-t border-line-subtle py-10 lg:py-12">
			<h2 class="text-2xl font-semibold text-primary sm:text-3xl">{correctionProcess.title}</h2>
			<ol class="mt-6 max-w-3xl list-decimal space-y-2 pl-5 text-sm text-secondary">
				{correctionProcess.steps.map((step) => <li>{step}</li>)}
			</ol>
			<p class="mt-6 max-w-3xl text-sm text-secondary">{correctionProcess.responseExpectation}</p>
		</section>

		<FAQ items={faqItems} title={faqSection.title} description={faqSection.description} />
	</main>
	<Footer />
</BaseLayout>

<script>
(function () {
	// Record timestamp when the form is first rendered (timing signal)
	const ftEl = document.getElementById('form_time') as HTMLInputElement | null;
	if (ftEl) ftEl.value = String(Date.now());

	// Auto-fill current page URL
	const puEl = document.getElementById('page_url') as HTMLInputElement | null;
	if (puEl) puEl.value = window.location.href;

	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const statusEl = document.getElementById('form-status') as HTMLElement | null;
	const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
	const msgEl = document.getElementById('message') as HTMLTextAreaElement | null;
	const msgCount = document.getElementById('message-count') as HTMLElement | null;

	// Live character count on message textarea
	if (msgEl && msgCount) {
		msgEl.addEventListener('input', () => {
			const len = msgEl.value.length;
			msgCount.textContent = `${len.toLocaleString()} / 5,000 characters.`;
		});
	}

	function showStatus(msg: string, isError: boolean): void {
		if (!statusEl) return;
		statusEl.textContent = msg;
		statusEl.className = [
			'rounded-lg px-4 py-3 text-sm',
			isError
				? 'bg-red-50 text-red-800 border border-red-200'
				: 'bg-green-50 text-green-800 border border-green-200',
		].join(' ');
	}

	if (!form) return;

	form.addEventListener('submit', async (e: Event) => {
		e.preventDefault();

		if (!statusEl || !submitBtn) return;

		// Client-side pre-validation
		const emailEl = document.getElementById('email') as HTMLInputElement | null;
		const email = emailEl?.value.trim() ?? '';
		const message = msgEl?.value.trim() ?? '';

		if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
			showStatus('Please enter a valid email address.', true);
			emailEl?.focus();
			return;
		}
		if (message.length < 10) {
			showStatus('Message must be at least 10 characters.', true);
			msgEl?.focus();
			return;
		}
		if (message.length > 5000) {
			showStatus('Message must be under 5,000 characters.', true);
			msgEl?.focus();
			return;
		}

		// Disable button, show in-flight state
		submitBtn.disabled = true;
		submitBtn.textContent = 'Sending…';
		statusEl.className = 'hidden';
		statusEl.textContent = '';

		try {
			const body = new FormData(form);
			const res = await fetch('/api/contact', {
				method: 'POST',
				body,
			});

			let json: { ok: boolean; error?: string } = { ok: false };
			try { json = await res.json(); } catch { /* ignore */ }

			if (json.ok) {
				showStatus('Message sent — thank you. We will review it and may reply to your email address.', false);
				form.reset();
				// Re-set hidden fields after reset
				if (ftEl) ftEl.value = String(Date.now());
				if (puEl) puEl.value = window.location.href;
				submitBtn.textContent = 'Send message';
				submitBtn.disabled = false;
			} else {
				showStatus(json.error ?? 'Something went wrong. Please try again.', true);
				submitBtn.textContent = 'Send message';
				submitBtn.disabled = false;
			}
		} catch {
			showStatus('Network error — please check your connection and try again.', true);
			submitBtn.textContent = 'Send message';
			submitBtn.disabled = false;
		}
	});
})();
</script>
