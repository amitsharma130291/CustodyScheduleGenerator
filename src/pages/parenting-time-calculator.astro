---
import CalculatorPageTemplate from '../components/pages/CalculatorPageTemplate.astro';
---

<CalculatorPageTemplate
	title="Parenting Time Calculator | Estimate Custody Overnights"
	description="Estimate parenting time, custody overnights, and visitation percentages for common custody schedules."
	slug="parenting-time-calculator"
	lede="Use the parenting time calculator to compare how custody days and overnights are divided between two parents."
	faq={[
		{
			question: 'What does a parenting time calculator measure?',
			answer: 'It measures how much time each parent has, usually by counting days or overnights across a schedule.',
		},
		{
			question: 'Which custody schedules produce common parenting-time splits?',
			answer: `After calculating your time, match it to a schedule: the <a href="/50-50-custody-schedule/" class="font-semibold text-accent underline decoration-line underline-offset-4 hover:text-primary">50/50 custody schedule</a> and <a href="/2-2-3-custody-schedule/" class="font-semibold text-accent underline decoration-line underline-offset-4 hover:text-primary">2-2-3 schedule</a> both achieve equal time, while the <a href="/week-on-week-off-custody-schedule/" class="font-semibold text-accent underline decoration-line underline-offset-4 hover:text-primary">week-on-week-off schedule</a> suits older children. See all options on the <a href="/best-50-50-custody-schedule/" class="font-semibold text-accent underline decoration-line underline-offset-4 hover:text-primary">best 50/50 schedule</a> page.`,
		},
		{
			question: 'How do I document my parenting-time arrangement?',
			answer: `Use a <a href="/parenting-plan-template/" class="font-semibold text-accent underline decoration-line underline-offset-4 hover:text-primary">parenting plan template</a> to formalise your agreed split into a court-ready document, or start with the <a href="/custody-agreement-builder/" class="font-semibold text-accent underline decoration-line underline-offset-4 hover:text-primary">custody agreement builder</a> to draft the schedule section.`,
		},
	]}
/>
