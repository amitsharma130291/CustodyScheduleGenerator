---
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCanonicalUrl } from '../lib/seo/metadata';
import { buildBreadcrumbSchema, buildWebPageSchema } from '../lib/seo/schema';

const title = 'Holiday Custody Planner';
const description = 'A holiday custody planner is coming soon to help organize school breaks, holidays, birthdays, and special days around a regular custody schedule.';
const canonical = '/holiday-custody-planner/';
const canonicalUrl = getCanonicalUrl(canonical);
const schema = [
	buildBreadcrumbSchema([
		{ name: 'Home', url: getCanonicalUrl('/') },
		{ name: 'Tools', url: getCanonicalUrl('/#tools') },
		{ name: title, url: canonicalUrl },
	]),
	{
		...buildWebPageSchema({ name: title, description, url: canonicalUrl }),
		isAccessibleForFree: true,
	},
];

const LINK_CLASS = 'font-semibold text-accent underline decoration-line underline-offset-4 hover:text-primary';
---

<BaseLayout title={`${title} | CustodyBuilder`} description={description} canonical={canonical} robots="noindex, follow">
	<JsonLd slot="head" data={schema} />
	<Navbar />
	<main class="container-shell py-14 lg:py-20">
		<section class="premium-card rounded-[2rem] p-3">
			<div class="rounded-[1.7rem] bg-surface-elevated/80 p-6 sm:p-8 lg:p-10">
				<p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">Coming soon</p>
				<h1 class="mt-4 max-w-3xl text-4xl font-semibold leading-[1.02] tracking-[-0.05em] text-primary sm:text-5xl">
					{title}
				</h1>
				<p class="mt-4 max-w-2xl text-base leading-7 text-secondary">
					{description}
				</p>
				<div class="mt-7 flex flex-col gap-3 sm:flex-row">
					<a href="/#tools" class="btn-primary inline-flex h-12 items-center justify-center rounded-full px-6 text-sm font-semibold">
						Explore Available Tools
					</a>
					<a href="/custody-schedule-generator/" class="btn-secondary inline-flex h-12 items-center justify-center rounded-full px-6 text-sm font-semibold">
						Open Schedule Generator
					</a>
				</div>
			</div>
		</section>

		<section id="related-resources" class="scroll-mt-24 py-12" aria-labelledby="related-resources-title">
			<div class="max-w-3xl">
				<p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">Keep exploring</p>
				<h2 id="related-resources-title" class="mt-3 text-3xl font-semibold tracking-[-0.04em] text-primary sm:text-4xl">Related Tools &amp; Resources</h2>
				<ul class="mt-6 space-y-3 text-base leading-7 text-secondary">
					<li class="flex gap-2"><span class="text-accent" aria-hidden="true">→</span><span>Build your base rotation with the <a href="/custody-schedule-generator/" class={LINK_CLASS}>custody schedule generator</a>.</span></li>
					<li class="flex gap-2"><span class="text-accent" aria-hidden="true">→</span><span>See how holidays overlay a regular schedule on the <a href="/holiday-custody-schedule/" class={LINK_CLASS}>holiday custody schedule</a> page.</span></li>
					<li class="flex gap-2"><span class="text-accent" aria-hidden="true">→</span><span>For limited-time parents, the <a href="/holiday-visitation-schedule/" class={LINK_CLASS}>holiday visitation schedule</a> guide covers access rights.</span></li>
					<li class="flex gap-2"><span class="text-accent" aria-hidden="true">→</span><span>Document all holiday clauses in a <a href="/parenting-plan-template/" class={LINK_CLASS}>parenting plan template</a>.</span></li>
					<li class="flex gap-2"><span class="text-accent" aria-hidden="true">→</span><span>Compare your schedule options with the <a href="/schedule-comparison-tool/" class={LINK_CLASS}>schedule comparison tool</a>.</span></li>
				</ul>
			</div>
		</section>
			<section class="container-shell border-t border-line-subtle py-8">
			<p class="max-w-3xl text-sm text-secondary">For families separated by significant distance, holiday planning involves travel logistics on top of schedule design. See the <a href="/long-distance-custody-schedule/" class="font-semibold text-accent underline decoration-line underline-offset-4 hover:text-primary">long-distance custody schedule guide</a> for holiday allocation in school-year/summer split arrangements.</p>
		</section>
	</main>
	<Footer />
</BaseLayout>
