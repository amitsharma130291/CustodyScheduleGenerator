			<h2 class="text-2xl font-semibold text-primary sm:text-3xl">Before You Submit: California Parenting Plan Checklist</h2>

			<div class="mt-6 max-w-3xl space-y-6">
				{[
					{
						section: 'Schedule',
						items: [
							'Specific start/end days and times for each parent\'s regular parenting time',
							'Start date identified',
							'Exchange location and transportation responsibility specified',
							'Statement that holiday schedule governs when it conflicts with regular schedule',
							'Separate school-year and summer schedules if different',
						],
					},
					{
						section: 'Holidays',
						items: [
							'Every major holiday named explicitly',
							'Exact start and end times for each holiday period (not just dates)',
							'Alternating year assignments designated for each alternating holiday',
							'Three-day weekends addressed (Memorial Day, Labor Day, Presidents\' Day)',
							'Summer vacation selection process with notification deadlines',
						],
					},
					{
						section: 'Decision-making',
						items: [
							'Joint or sole legal custody designated clearly',
							'Categories of "major decisions" defined',
							'Tiered dispute resolution process: discussion → coordinator → tiebreaker',
							'Emergency decision authority specified (attending parent decides; notifies other)',
						],
					},
					{
						section: 'School enrollment',
						items: [
							'Enrollment address designated explicitly',
							'Both parents\' portal/record access affirmed',
							'What happens if enrollment-address parent moves out of district',
						],
					},
					{
						section: 'Language and forms',
						items: [
							'"Parenting time" used throughout (not "visitation")',
							'FL-341 and applicable attachments identified for court filing',
							'County-specific local rules checked',
						],
					},
				].map((group) => (
					<div>
						<h3 class="font-semibold text-primary">{group.section}</h3>
						<ul class="mt-2 space-y-1">
							{group.items.map((item) => (
