---
import '../styles/global.css';
import ScrollToTop from '../components/ScrollToTop.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getCanonicalUrl } from '../lib/seo/metadata';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	ogType?: string;
	ogTitle?: string;
	ogDescription?: string;
	robots?: string;
}

const {
	title = 'CustodyBuilder | Free Custody Schedule Generator',
	description = 'Create clear, printable custody and parenting time schedules with a premium, easy-to-use calendar generator.',
	canonical = Astro.url.pathname,
	ogType = 'website',
	ogTitle = title,
	ogDescription = description,
	robots = 'index, follow',
} = Astro.props;

const siteUrl = 'https://custodybuilder.com/';
const canonicalUrl = getCanonicalUrl(canonical, siteUrl);
const defaultImageUrl = new URL('/og/custodybuilder-og.png', siteUrl).toString();
const shouldLoadAnalytics = import.meta.env.PROD;
---

<!doctype html>
<html lang="en-US" data-theme="light" style="color-scheme: light;">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta http-equiv="content-language" content="en-US" />
		<script is:inline>
			// html has `scroll-behavior: smooth` sitewide (global.css). If the URL
			// already has a #hash, the browser performs its own native
			// scroll-to-anchor as the page loads — and that native jump inherits
			// the smooth-scroll animation too. An animated jump that starts before
			// the page (fonts, images, hydrating components) has finished laying
			// out very often gets interrupted by the resulting layout shifts and
			// never reaches the target, stranding the visitor near the top.
			// Forcing 'auto' (instant) before that native jump runs — then
			// restoring 'smooth' once the page has actually finished loading —
			// keeps in-page smooth-scrolling (nav links, buttons) working exactly
			// as before while making the initial landing reliable.
			if (location.hash) {
				document.documentElement.style.scrollBehavior = 'auto';
				window.addEventListener(
					'load',
					function () {
						window.setTimeout(function () {
							document.documentElement.style.scrollBehavior = '';
						}, 200);
					},
					{ once: true },
				);
			}
		</script>
		<script is:inline>
			try {
				const storedTheme = localStorage.getItem('theme');
				const theme = storedTheme === 'light' || storedTheme === 'dark' ? storedTheme : 'light';
				document.documentElement.dataset.theme = theme;
				document.documentElement.style.colorScheme = theme;
			} catch {
				document.documentElement.dataset.theme = 'light';
				document.documentElement.style.colorScheme = 'light';
			}
		</script>
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
		<link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="CustodyBuilder" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={defaultImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={ogTitle} />
		<meta name="twitter:description" content={ogDescription} />
		<meta name="twitter:image" content={defaultImageUrl} />
		<meta name="theme-color" content="#0F172A" />
		<meta name="generator" content={Astro.generator} />
		{shouldLoadAnalytics && (
			<>
				<script async src="https://www.googletagmanager.com/gtag/js?id=G-ZEM3ECSRZH"></script>
				<script is:inline>
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}

					// Google Consent Mode v2 — default everything to DENIED before GA4 configures,
					// so no analytics/ad cookies are set until the visitor accepts via the banner.
					// A stored prior choice is applied immediately so returning visitors aren't re-gated.
					gtag('consent', 'default', {
						ad_storage: 'denied',
						analytics_storage: 'denied',
						ad_user_data: 'denied',
						ad_personalization: 'denied',
						functionality_storage: 'granted',
						security_storage: 'granted',
						wait_for_update: 500,
					});
					try {
						var storedConsent = localStorage.getItem('cb-consent');
						if (storedConsent === 'granted') {
							gtag('consent', 'update', {
								ad_storage: 'granted',
								analytics_storage: 'granted',
								ad_user_data: 'granted',
								ad_personalization: 'granted',
							});
						}
					} catch (e) {}

					gtag('js', new Date());
					gtag('config', 'G-ZEM3ECSRZH');

					let trackedLocation = window.location.href;
					document.addEventListener('astro:page-load', () => {
						if (window.location.href === trackedLocation) return;
						trackedLocation = window.location.href;
						gtag('config', 'G-ZEM3ECSRZH', {
							page_title: document.title,
							page_location: window.location.href,
							page_path: window.location.pathname + window.location.search,
						});
					});
				</script>
			</>
		)}
		{/* Google AdSense verification — publisher ID only; no ad units, no Auto ads */}
		{shouldLoadAnalytics && (
			<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6726234905496938" crossorigin="anonymous"></script>
		)}
		<slot name="head" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<ScrollToTop />
		{shouldLoadAnalytics && <CookieConsent />}
		<script is:inline>
			// Backstop for the head-script fix above: if a client-hydrated
			// component (the year-calendar form, the promo banner's preview
			// stack) changes layout height above the anchor after the browser's
			// native jump already landed, this re-applies the same instant jump
			// once the page — and any late layout shifts — have settled.
			(function () {
				function scrollToHash() {
					var hash = window.location.hash;
					if (!hash || hash.length < 2) return;
					var id = hash.slice(1);
					try {
						id = decodeURIComponent(id);
					} catch (e) {}
					var target = document.getElementById(id);
					if (!target) return;
					target.scrollIntoView({ behavior: 'auto', block: 'start' });
				}
				function runAfterLoad() {
					window.setTimeout(scrollToHash, 150);
				}
				if (document.readyState === 'complete') {
					runAfterLoad();
				} else {
					window.addEventListener('load', runAfterLoad);
				}
			})();
		</script>
	</body>
</html>
